<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://scheduleEdit.caption"
        focusComponent="form"
        messagesPack="com.company.scheduler.web.screens.schedule">
    <data>
        <instance id="scheduleDc"
                  class="com.company.scheduler.entity.Schedule">
            <view extends="_local">
                <property name="subject" view="_minimal"/>
                <property name="teacher" view="_minimal"/>
                <property name="students" view="_minimal"/>
            </view>
            <loader/>
            <collection id="studentsDc" property="students"/>
        </instance>
    </data>
    <dialogMode height="600"
                width="800"/>
    <layout expand="editActions" spacing="true">
        <form id="form" dataContainer="scheduleDc">
            <column width="350px">
                <pickerField id="subjectField" property="subject">
                    <actions>
                        <action id="lookup" type="picker_lookup"/>
                        <action id="clear" type="picker_clear"/>
                    </actions>
                </pickerField>
                <pickerField id="teacherField" property="teacher">
                    <actions>
                        <action id="lookup" type="picker_lookup"/>
                        <action id="clear" type="picker_clear"/>
                    </actions>
                </pickerField>
                <textField id="durationField" property="duration"/>
            </column>
        </form>
        <groupBox id="studentsBox" caption="msg://com.company.scheduler.entity/Schedule.students">
            <table id="studentsTable" dataContainer="studentsDc" width="100%" height="200px">
                <actions>
                    <action id="add" type="add"/>
                    <action id="exclude" type="exclude"/>
                </actions>
                <columns>
                    <column id="lastName"/>
                    <column id="firstName"/>
                </columns>
                <buttonsPanel>
                    <button action="studentsTable.add"/>
                    <button action="studentsTable.exclude"/>
                </buttonsPanel>
            </table>
        </groupBox>
        <hbox id="editActions" spacing="true">
            <button id="commitAndCloseBtn" action="windowCommitAndClose"/>
            <button id="closeBtn" action="windowClose"/>
        </hbox>
    </layout>
</window>
