<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        xmlns:c="http://schemas.haulmont.com/cuba/screen/jpql_condition.xsd"
        caption="msg://teacherBrowse.caption"
        focusComponent="teachersTable"
        messagesPack="com.company.scheduler.web.screens.teacher">
    <data readOnly="true">
        <collection id="teachersDc"
                    class="com.company.scheduler.entity.Teacher">
            <view extends="_local"/>
            <loader id="teachersDl">
                <query>
                    <![CDATA[select e from scheduler_Teacher e]]>
                </query>
            </loader>
        </collection>
    </data>
    <dialogMode height="600"
                width="800"/>
    <layout expand="teachersTable"
            spacing="true">
        <filter id="filter"
                applyTo="teachersTable"
                dataLoader="teachersDl">
            <properties include=".*"/>
        </filter>
        <dataGrid id="teachersTable"
                  width="100%"
                  dataContainer="teachersDc">
            <actions>
                <action id="create" type="create"/>
                <action id="edit" type="edit"/>
                <action id="remove" type="remove"/>
            </actions>
            <columns>
                <column property="firstName" id="firstName"/>
                <column property="lastName" id="lastName"/>
            </columns>
            <rowsCount/>
            <buttonsPanel id="buttonsPanel"
                          alwaysVisible="true">
                <button id="createBtn" action="teachersTable.create"/>
                <button id="editBtn" action="teachersTable.edit"/>
                <button id="removeBtn" action="teachersTable.remove"/>
            </buttonsPanel>
        </dataGrid>
        <hbox id="lookupActions" spacing="true" visible="false">
            <button action="lookupSelectAction"/>
            <button action="lookupCancelAction"/>
        </hbox>
    </layout>
</window>
